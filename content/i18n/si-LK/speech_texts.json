  "pg019_n0004": "ජම්බු ගෙඩියක් කැඩුවා.",
  "pg019_n0005": "ලේන් පැටියාට දුන්නා.",
  "pg019_im003_crop_v1": "ලේනා ගසක අත්තේ සිටී. ජම්බු ගෙඩියක් පහළට වැටෙයි.",
  "pg019_n0007": "පුංචි මලී ජම්බු කන්න",
  "pg019_n0008": "හරි ආසයි.",
  "pg019_n0010": "අම්මේ",
  "pg019_n0011": "මට ජම්බු ගෙඩියක්",
  "pg019_n0012": "කඩලා දෙන්න.",
  "pg019_n0013": "ජම්බු තියෙන්නේ",
  "pg019_n0014": "උස අතුවල නේ.",
  "pg019_im002": "අම්මා දියණිය සමඟ ගෙදර ඉදිරිපිට සිටී. දෙන්නාම ඉහළ බලා සිටිති.",
  "pg019_n0016": "මේ කතාව",
  "pg019_n0017": "ලේන් අම්මාට ඇහුණා.",
  "pg019_n0018": "ලේන් අම්මා",
  "pg019_n0019": "ජම්බු ගෙඩියක් කැඩුවා.",
