  "pg025_n0011": "පැන ගිය තාරක",
  "pg025_n0012": "අන්තිම කොටුවට",
  "pg025_n0013": "සතුටින් පැන්නා",
  "pg025_im001": "ළමයින් හතර දෙනෙක් එළියේ කොටුව සෙල්ලම් කරති. අසල ගසක කුරුල්ලන් දෙදෙනෙක් සහ කටුස්සෙක් ඉඳී.",
  "pg026_n0002": "පහ, අවුරුදු ආවා",
  "pg026_im001": "ගසක අත්තක බැඳි ඔංචිල්ලාවක ගැහැණු ළමයෙක් පැදෙයි. ළමයි දෙදෙනා අසල සිට බලා සිටින අතර අත්ත මත කුරුල්ලන් දෙදෙනා ඉඳගෙන සිටිති.",
  "pg026_n0004": "චට පට චට පට",
  "pg026_n0005": "අවුරුදු අවුරුදු",
  "pg026_n0006": "අද අපට අවුරුදු",
  "pg026_n0007": "සහන් කිවුවා.",
  "pg026_n0009": "අලුත් අලුත් ඇඳුම්",
  "pg026_n0010": "රස රස කැවිලි",
  "pg026_n0011": "අපට හරි සතුටුයි.",
  "pg026_n0012": "පවනි කිවුවා.",
  "pg027_n0002": "පුතා එන්න.",
  "pg027_n0003": "දුවත් එන්න.",
  "pg027_n0004": "නැකත් වෙලාව ළඟයි.",
  "pg027_n0005": "අම්මයි තාත්තයි",
  "pg027_n0006": "අපට කිරිබත් කැවුවා.",
  "pg027_n0007": "එන්න නංගි",
  "pg027_n0008": "අපි අම්මාටයි තාත්තාටයි",
  "pg027_n0009": "බුලත් දී වඳිමු.",
  "pg027_im001": "අවුරුදු දවසේ දරුවන් අම්මාටයි තාත්තාටයි වැඳ ආශීර්වාද ගනී. මේසය උඩ කැවිලිත් පහනත් තිබේ.",
  "pg028_n0002": "අයියේ අන්න රාමන්ලා එනවා.",
  "pg028_n0003": "එන්න දුව එන්න පුතා",
  "pg028_n0004": "අවුරුදු සරුයි වගේ",
  "pg028_n0005": "තාත්තා හැමෝට ම",
  "pg028_n0006": "ආයුබෝවන් කිවුවා.",
  "pg028_n0007": "අපි තේ බොමු.",
  "pg028_n0008": "කැවුම් කොකිස් කිරිබත් තියෙනවා.",
  "pg028_n0009": "අම්මා කිවුවා.",
  "pg028_n0010": "මම මුංකැවුම් කන්න කැමතියි.",
  "pg028_n0011": "රාමන් කිවුවා.",
  "pg028_n0012": "මේ කැවිලි හරි රසයි.",
  "pg028_im001": "ළමයි දෙන්නා අත් එක්කර ආයුබෝවන් කියමින් වැඩිහිටියෙකු පිළිගනී. ගෙදරට එන අයව සතුටින් පිළිගන්නා දර්ශනයකි.",
  "pg029_n0002": "අපි රබන් ගහමු.",
  "pg029_n0004": "පවනි රබන් පද කිවුවා.",
  "pg029_n0006": "එගොඩ ගොඩෙත් රත්තරං",
  "pg029_n0007": "මෙගොඩ ගොඩෙත් රත්තරං",
  "pg029_n0008": "එගොඩ ගොඩෙත් මෙගොඩ ගොඩෙත්",
  "pg029_n0009": "ඇතෙක් බරට රත්තරං.",
  "pg029_n0011": "හැමෝම තාලෙට රබන් ගැසුවා.",
  "pg029_im001": "ගසක් යට ළමයින් හතර දෙනා රබනක් වටේ සතුටින් එකතු වී සිටිති. අත්තක කුරුල්ලෙක් ඉඳගෙන ඇති අතර ගසෙහි කජු ගෙඩිත් පෙනේ.",
  "pg030_n0002": "හය, කිරි සුදු හාවා",
  "pg030_im002": "සුදු හාවා තණකොළ අතර වාඩි වී ඉන්නවා. එයාගේ දිග කන් දෙක ඉහළට නැගී තිබේ.",
  "pg030_n0004": "පුළුන් වගේ සුදු හාවා",
  "pg030_n0005": "කන් දෙක ඔසවා බැලුවා",
  "pg030_n0006": "පඳුරු උඩින් පැන ආවා",
  "pg030_n0007": "උඳුපියළිය කොළ කෑවා",
  "pg030_im005_crop_v1": "සුදු හාවා ගලක් ළඟ පෙරළී ඉන්නවා. වටේ තණකොළ සහ පුංචි මල් තිබේ.",
  "pg030_n0009": "පැන පැන ආ සුදු හාවා",
  "pg030_n0010": "ආයෙත් වටපිට බැලුවා",
  "pg030_n0011": "වත්ත පහළ වෙල ගාවා",
  "pg030_n0012": "සතුටින් පිනුමක් ගැහුවා",
  "pg031_n0002": "සීතල සුළඟක් හැමුවා",
  "pg031_n0003": "ගස්වල දලු කොළ නැටුවා",
  "pg031_n0004": "කුරුලු පැටව් ගී ගැයුවා",
  "pg031_n0005": "තාලෙට අත්තටු සැලුවා",
  "pg031_im001": "ගසක කූඩුවක කුරුලු පැටවුන් තුන්දෙනෙක් කෑගසමින් ඉන්නවා. පහළින් සුදු හාවෙක් තණකොළ අතර දුවනවා.",
  "pg032_n0002": "හත.",
  "pg032_n0003": "යාළු මාළු",
  "pg032_n0005": "අද නිවාඩු දවසක්.",
  "pg032_n0006": "මනුක මිදුලට බැස්සා.",
  "pg032_n0007": "ඇළ ළඟට ගියා.",
  "pg032_n0008": "වතුරත් අඩුයි.",
  "pg032_n0010": "ඇළේ වතුර",
  "pg032_n0011": "හරි පැහැදිලියි.",
  "pg032_n0012": "මාළු හොඳට පේනවා.",
  "pg032_n0013": "බලාගෙන ඉන්න ආසයි.",
  "pg032_n0015": "මෙන්න පුංචි මාළුවෙක්.",
  "pg032_n0016": "පුංචි මාළුවා",
  "pg032_n0017": "හරිම සතුටින්",
  "pg032_n0018": "එහාට පීනනවා",
  "pg032_n0019": "මෙහාට පීනනවා.",
  "pg032_im001": "ගසක් යට ඇළ අසල කුඩා ළමයෙක් නැවී බලයි. ඇළේ කුඩා මාලුවෙක් පිහිනා යයි.",
  "pg032_n0021": "උඩට එනවා",
  "pg032_n0022": "යටට යනවා.",
  "pg032_n0023": "වතුර බුබුළු හදනවා මනුක දැක්කා.",
  "pg033_n0002": "පුංචි මාළුවා ආයෙමත්",
  "pg033_n0003": "එහාට පීනනවා",
  "pg033_n0004": "මෙහාට පීනනවා.",
  "pg033_n0006": "උඩට එනවා",
  "pg033_n0007": "යටට යනවා.",
  "pg033_n0008": "වතුර බුබුළු හදනවා.",
  "pg033_n0010": "පුංචි මාළුවෝ",
  "pg033_n0011": "මටත් ආසයි පීනන්න.",
  "pg033_n0012": "ඔයාගෙ වරල් මට දෙන්න.",
  "pg033_n0013": "මනුක කිවුවා.",
  "pg033_n0015": "පුංචි මාළුවා වතුර යටට පීනා ගියා.",
  "pg033_n0016": "අම්මගෙන් අහන්න වෙන්න ඇති",
  "pg033_n0017": "මනුක සිතුවා.",
  "pg033_im001": "කුඩා පිරිමි දරුවෙක් ඇළ ළඟ දණ ගසා ජලය දෙස බලයි. ඇළ දෙපස කොළ පැළ හා රෝස මල් පිපී ඇත.",
  "pg034_n0002": "අට. සිඟිති පොළ",
  "pg034_n0004": "අපි හෙට පොළක් දමමු.",
  "pg034_n0005": "ගුරුතුමී කිවුවා.",
  "pg034_n0006": "හැමෝම පොළට",
  "pg034_n0007": "බඩු ගේන්න.",
  "pg034_n0008": "බඩු විකුණන්නේ ළමයි.",
  "pg034_n0009": "දෙමව්පියන්ටත්",
  "pg034_n0010": "එන්න කියන්න.",
  "pg034_im001": "ගුරුතුමිය පන්තියේ ළමයින් සමඟ කතා කරයි. ළමයි ඇය දෙස බලා සතුටින් අසගෙන සිටිති.",
  "pg035_im001": "ළමයි පාසලේ පොළකට එළවළු ගෙනැවිත් විකුණති. එක් ළමයෙක් තරාදියකින් එළවළු බර මැන බලයි.",
  "pg035_n0002": "ළමයි පොළට බඩු ගෙනාවා.",
  "pg035_n0003": "රාබු කැරට් බටු පතෝල පොළේ තිබුණා.",
  "pg035_n0004": "පවනි බණ්ඩක්කා විකුණුවා.",
  "pg035_n0005": "කසුන් මෑ කරල් විකුණුවා.",
  "pg035_n0006": "ළමයි හැමෝම මුදලාලිලා වුණා.",
  "pg036_n0002": "බඩු ගන්න අම්මලා ආවා.",
  "pg036_n0003": "තාත්තලොත් ආවා.",
  "pg036_n0004": "හැමෝම බඩු මිල දී ගත්තා.",
  "pg036_im001": "පාසල් ළමයින් මල් සහ පොල් විකුණති. අම්මාත් තාත්තාත් ඒවා ගන්නට පැමිණි අතර, ළමයින් සතුටින් කතා කරති.",
  "pg037_im004": "ගසෙන් දූලෙන මකුළුවා දෙස කුඩා ළමයෙක් බලයි. ඔහු තණකොළ මත හිටගෙන අත උස්සයි.",
  "pg037_n0002": "නවය. පුංචි මකුළුවා",
  "pg037_n0004": "පුංචි මකුළු",
  "pg037_n0005": "යාළුවේ",
  "pg037_n0006": "තනියම ඇයි",
  "pg037_n0007": "පාළුවේ",
  "pg037_n0008": "දැල වියන්න",
  "pg037_n0009": "යාළුවේ",
  "pg037_n0010": "තැනක් සොයමි",
  "pg037_n0011": "පාඩුවේ",
  "pg037_n0012": "පේර ගසේ උඩ",
  "pg037_n0013": "අත්තේ",
  "pg037_n0014": "හොඳම තැනක් එහි",
  "pg037_n0015": "ඇත්තේ",
  "pg037_n0016": "පේර ගසේ දැල",
  "pg037_n0017": "ගොතලා",
  "pg037_n0018": "වැස්සට යයි දෝ",
  "pg037_n0019": "කැඩිලා",
  "pg037_n0020": "අපේ ගෙදර ගෙයි",
  "pg037_n0021": "මුල්ලක",
  "pg037_n0022": "දැල වියන්න එන්න",
  "pg037_n0023": "හණික",
  "pg038_im002_seg001_v1": "මකුළුවා තම ජාලය අසල සිටී. සුදු ජාලය නිල් පසුබිමක පෙනේ.",
  "pg038_n0002": "හොඳයි ඉතින් දැල වියන්න",
  "pg038_n0003": "පුංචි ඔයත් බලන් ඉන්න",
  "pg038_n0005": "ඔය ලස්සන දැල වියන්න",
  "pg038_n0006": "අනේ මටත් කියා දෙන්න",
  "pg038_n0008": "වට රවුමට දැල",
  "pg038_n0009": "වියන්න",
  "pg038_n0010": "අම්මයි මට කියල",
  "pg038_n0011": "දුන්නේ",
  "pg038_im002_seg002_v1": "කුඩා ළමයෙක් නිකටට අත තබා කල්පනා කරයි. ඔහු ඉහළ බලා සිටී.",
  "pg038_n0013": "වියන්න",
  "pg038_n0014": "දුන්නෙ",
  "pg039_im001": "දැල මත මකුළුවා ඉන්නවා. සුදු මකුළු දැල අහස පසුබිමේ පැතිරී ඇත.",
  "pg039_n0002": "තද සුළඟක් එන්න එපා",
  "pg039_n0003": "දැල අරගෙන යන්න එපා",
  "pg039_n0004": "මේ ලස්සන මකුළු දැලට",
  "pg039_n0005": "කරදරයක් වෙන්න එපා",
  "pg040_n0002": "දහය. සත්තු වත්ත",
  "pg040_n0004": "පුතාලා ඊයේ කොහේ ද ගියේ?",
  "pg040_n0005": "සීයේ අපි සත්තු වත්තට ගියා.",
  "pg040_n0006": "සත්තු වත්තේ ගොඩක් සත්තු හිටිය ද?",
  "pg040_n0007": "ඔව් සීයේ.",
  "pg040_n0008": "මින් මැදුර හරි ලස්සනයි.",
  "pg040_n0009": "පාට පාට මාළුවෝ පීන පීන හිටියා.",
  "pg040_im001": "දරුවන් දෙදෙනා වර්ණවත් මාළු පීනන තැනය බලති. එක දරුවෙක් මාළුවෙකු දිහා ඇඟිල්ලෙන් පෙන්වයි.",
  "pg041_n0002": "පුතාලා අලි නැටුම් බැලුවේ නැද්ද?",
  "pg041_n0003": "බැලුවා, හරිම ලස්සනයි සීයේ.",
  "pg041_n0004": "නංගි අලි පේළිය දැක්කා ද?",
  "pg041_n0005": "ඔව් අයියේ",
  "pg041_n0006": "අලි පැටියෙක් බිම වාඩි වුණා.",
  "pg041_n0007": "පිනුම් ගැහුවා.",
  "pg041_n0008": "උඩ පැන පැන නැටුවා.",
  "pg041_n0009": "අපි හයියෙන් අත්පොඩි ගැහුවා.",
  "pg041_n0010": "අපිට හරි සතුටුයි.",
  "pg041_im002": "අලි පැටවුන් වටයක් වටා සෙල්ලම් කරයි. එක අලියෙක් තවත් අලියෙකුගේ වලිගය අල්ලාගෙන ඉන්නවා.",
  "pg042_n0002": "පුංචි පුංචි මල් වගේ",
  "pg042_n0003": "ළමා ළපටි හරි අගේ",
  "pg042_n0004": "ඇවිදීමෙන් රට වටේ",
  "pg042_n0005": "දැන ගත හැකි බොහොම දේ",
  "pg042_im001": "ළමයින් සත්තු බලන්න ගිහින් ඉන්නවා. එතැන ජිරාෆ්, මුවන්, ගිරවුන්, කුරුල්ලන් සහ නෙමලෙක් ඉන්නවා.",
  "pg043_n0002": "එකොළහ. පුහුල් හොරා කරෙන් දැනේ",
  "pg043_n0004": "ගමරාලගේ එළවළු කොටුවේ පුහුල් වැලක් තිබුණා.",
  "pg043_n0005": "ඒ වැලේ ලොකු පුහුල් ගෙඩියක් තිබුණා.",
  "pg043_n0006": "දවසක් ගමරාල ඒක කඩා ගන්න කොටුවට ගියා.",
  "pg043_n0007": "පුහුල් ගෙඩිය තිබුණේ නෑ.",
  "pg043_n0008": "පුහුල් ගෙඩියට මොක ද වුණේ?",
  "pg043_n0009": "ගමරාල කල්පනා කළා.",
  "pg043_im002": "එළවළු වත්තේ ගමරාළ කෙනෙක් හිස අල්ලගෙන කල්පනා කරයි. වටේ වම්බටු, වැල් සහ මල් පෙනේ.",
  "pg044_im002": "ගමේ මිනිසෙක් අතේ ගෙන්ඩියක් අල්ලා සතුටින් නටයි. වටේ ඉන්න ගම්වැසියෝ ඔහු දෙස බලා සිටිති.",
  "pg044_n0002": "ගමරාල ගෙදර ගියා.",
  "pg044_n0003": "සීනුවක් නාද කරන්න පටන් ගත්තා.",
  "pg044_n0004": "මිනිස්සු ගමරාල වටේ එකතු වුණා.",
  "pg044_n0005": "මගේ කොටුවේ තිබුණු පුහුල් ගෙඩිය නෑ.",
  "pg044_n0006": "පුහුල් හොරා කරෙන් දැනේ.",
  "pg044_n0007": "පුහුල් හොරා කරෙන් දැනේ.",
  "pg044_n0008": "ගමරාල කිවුවා.",
  "pg044_n0009": "ගමරාල එහෙම කියනකොට එක් කෙනෙක් තමන්ගේ කර පිස දැම්මා.",
  "pg044_n0010": "ගමරාල ඒක දැක්කා.",
  "pg045_n0002": "දොළහ. හිමිදිරි උදය",
  "pg045_n0004": "කන්ද උඩින් ඉර පායා",
  "pg045_n0005": "රැස් විහිදෙනවා",
  "pg045_n0006": "පාට පාට මල් පිපිලා.",
  "pg045_n0007": "සුවඳ හමනවා",
  "pg045_im001": "මල් අතරින් කුඩා මුවෙක් දුවයි. එය ගසක්, සමනලයන් සහ කඳු පසුබිම ඇති ලස්සන වනයක සිටියි.",
  "pg045_n0009": "රංචු රංචු සමනලයින්",
  "pg045_n0010": "මල් පැණි බොනවා",
  "pg045_n0011": "වසු පැටියා දුව පනිමින්",
  "pg045_n0012": "අම්මා සොයනවා",
  "pg046_im002": "පාසල් ළමයි මල් අතේ රැගෙන දියපාර අසලින් පාසලට යති. වතුරේ නෙළුම් මල් පිපී ඇත, අතු මත කුරුල්ලෝ ඉඳගෙන සිටිති.",
  "pg046_n0002": "ලියදි පුරා ළපටි ගොයම",
  "pg046_n0003": "සුළඟෙ වැනෙනවා",
  "pg046_n0004": "දොළ පාරේ සීත ජලය",
  "pg046_n0005": "උතුරා යනවා",
  "pg046_n0006": "කුරුලු රංචු කීචි බීචි",
  "pg046_n0007": "සින්දු කියනවා",
  "pg046_n0008": "පුංචි ළමයි හරි සතුටින්",
  "pg046_n0009": "පාසල් යනවා",
  "gl001": "අත්ත",
  "gl001_def": "ගසෙන් පිටතට දිගට යන කොටස.",
