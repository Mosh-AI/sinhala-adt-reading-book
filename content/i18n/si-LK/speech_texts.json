  "gl070_def": "එකට එකතු වී ඇති පළතුරු හෝ මල් ගොඩක්.",
  "gl071": "පොළ",
  "gl071_def": "බඩු ගෙනවිත් විකුණන සහ මිලදී ගන්න ස්ථානයක්.",
  "gl072": "බට්ටා",
  "gl072_def": "පැන පැන සෙල්ලම් කරන ළමා ක්‍රීඩාවක්.",
  "gl073": "බඩගිනි",
  "gl073_def": "කෑම කන්න ඕනෑ වෙන හැඟීම.",
  "gl074": "බණ්ඩක්කා",
  "gl074_def": "කොළ පැහැති දිග එළවළුවක්.",
  "gl075": "බත්",
  "gl075_def": "අපි කෑමට ගන්න ප්‍රධාන ආහාරයක්.",
  "gl076": "බිම",
  "gl076_def": "අපි නගින හෝ යන පහළ තැන.",
  "gl077": "බුබුළු",
  "gl077_def": "වතුර හෝ දියර තුළින් උඩට එන වායු ගෝලාකාර කුඩා පින්දු වගේ දේවල්.",
  "gl078": "බුලත්",
  "gl078_def": "වැඳීමට හෝ ආචාරයට භාවිත කරන කොළ වර්ගයක්.",
  "gl079": "බෙදනවා",
  "gl079_def": "එක දෙයක් කිහිප දෙනාට වෙන් කර දෙනවා.",
  "gl080": "මකුළුවා",
  "gl080_def": "දැල් වියන කුඩා ජීවියෙක්.",
  "gl081": "මල",
  "gl081_def": "ගසක හෝ පැළයක පිපෙන ලස්සන කොටස.",
  "gl082": "මල්",
  "gl082_def": "ගස්වල පිපෙන ලස්සන කොටස.",
  "gl083": "මාළුවෝ",
  "gl083_def": "ජලයේ ජීවත් වන සතුන්.",
  "gl084": "මැදුර",
  "gl084_def": "විශේෂ දෙයක් තබා ඇති ගොඩනැගිල්ලක් හෝ ස්ථානයක්.",
  "gl085": "මිලදී",
  "gl085_def": "මුදල් දී යමක් ලබා ගැනීම.",
  "gl086": "මුදලාලිලා",
  "gl086_def": "වෙළඳාම කරන හෝ බඩු විකුණන අය.",
  "gl087": "මුල්ල",
  "gl087_def": "කාමරයක හෝ ගෙයක කෙළවර කොණ.",
  "gl088": "යට",
  "gl088_def": "කෙසේ හෝ දේක පහළ පැත්ත.",
  "gl089": "රතු",
  "gl089_def": "ලේ පාට වගේ වර්ණයක්.",
  "gl090": "රත්තරං",
  "gl090_def": "වටිනා කහ පැහැති ලෝහයක්.",
  "gl091": "රබන්",
  "gl091_def": "අතෙන් ගසා ශබ්ද කරන වාදනයක්.",
  "gl092": "රවුම",
  "gl092_def": "වටකුරු හැඩය.",
  "gl093": "රැස්",
  "gl093_def": "ඉරෙන් හෝ ආලෝකයෙන් පළවන කිරිණි.",
  "gl094": "රූප",
  "gl094_def": "ඇඳීම් හෝ පෙනෙන හැඩ.",
  "gl095": "ලස්සන",
  "gl095_def": "බලන විට හොඳට පෙනෙන, අලංකාර.",
  "gl096": "ලේනා",
  "gl096_def": "ගස්වල දුවන පුංචි සතෙක්.",
  "gl097": "ලේන් අම්මා",
  "gl097_def": "කුඩා සතෙකුගේ අම්මා.",
  "gl098": "වඳිමු",
  "gl098_def": "ගරු කිරීම සඳහා ආචාර කරනවා.",
  "gl099": "වරල්",
  "gl099_def": "මාළුවාට වතුරේ ගමන් කරන්න සහ සමබරව ඉන්න උපකාර කරන කොටස්.",
  "gl100": "වැල",
  "gl100_def": "පස මත හෝ තවත් දේවල් මත පැතිරෙමින් වැඩෙන ශාකයක්.",
  "gl101": "වැල්",
  "gl101_def": "දිගට වර්ධනය වන පැළෑටි කොටස්.",
  "gl102": "විකුණුවා",
  "gl102_def": "බඩුවක් මුදල් අරගෙන වෙන කෙනෙකුට දුන්නා.",
  "gl103": "වියන්න",
  "gl103_def": "නූල් හෝ තන්තු එකට බැඳ රටාවක් සාදන්න.",
  "gl104": "සතුටු",
  "gl104_def": "හිතට හොඳ, ප්‍රීතිමත් හැඟීම.",
  "gl105": "සත්තු වත්ත",
  "gl105_def": "සතුන් තබා බලන්න පුළුවන් ස්ථානය. එය සත්වෝද්‍යානයක් ලෙසත් හඳුන්වයි.",
  "gl106": "සමනලයින්",
  "gl106_def": "පාට පාට පියාපත් ඇති පියාඹන කීටයන්.",
  "gl107": "සීතල",
  "gl107_def": "උණුසුම අඩු, හීන් තැන්පත් තත්ත්වය.",
  "gl108": "සීනුව",
  "gl108_def": "ගහන විට ශබ්දයක් නිකුත් වන උපකරණයක්.",
  "gl109": "සුළඟ",
  "gl109_def": "වායුව හමා යාම; හුළඟ.",
  "gl110": "සෙල්ලම්",
  "gl110_def": "විනෝදයට කරන ක්‍රියා.",
  "gl111": "ස්තුති",
  "gl111_def": "කෙනෙකු කළ හොඳ දෙයකට කියන කෘතඥ වචනය.",
  "gl112": "හණික",
  "gl112_def": "ඉක්මනින්; වහාම.",
  "gl113": "හිමිදිරි",
  "gl113_def": "ඉතා ඉක්මනින් උදේ වන වෙලාව.",
  "gl114": "හොරා",
  "gl114_def": "අනුන්ගේ දේ අවසර නැතුව ගන්නා කෙනා.",
  "qz001_que": "මෙම පිටු වලින් ළමයාට කරන්න කියන්නේ කුමක්ද?",
  "qz001_o0": "එක, අකුරු ලියන්න",
  "qz001_o0_exp": "නැහැ. මෙහි අකුරු ලියන්න කියලා නැහැ. පින්තූර බලා කතාව කියන්න කියලා තිබෙනවා.",
  "qz001_o1": "දෙක, කතාව කියන්න",
  "qz001_o1_exp": "හරි! මෙම පිටු වල 'පින්තූර බලා කතාව කියන්න' කියලා උපදෙස් දීලා තියෙනවා.",
  "qz001_o2": "තුන, ගීතයක් ගායනා කරන්න",
  "qz001_o2_exp": "නැහැ. මෙම පිටු වල ගීතයක් ගැන නොව, පින්තූර බලලා කතාව කියන්න කියලා ඇත.",
  "qz002_que": "පිටුවල වැඩිපුර කතා කරන්නේ කුමක් ගැනද?",
  "qz002_o0": "එක, සතුන්",
  "qz002_o0_exp": "❌ තව ටිකක් හිතන්න. මේ පාඩමේ සතුන් ගැන නොව, මල් ගැනයි.",
  "qz002_o1": "දෙක, ගෙවල්",
  "qz002_o1_exp": "❌ නැහැ. මේ පිටු වල ගෙවල් ගැන නොව, මල් ගැන කියලා තිබෙනවා.",
  "qz002_o2": "තුන, මල්",
  "qz002_o2_exp": "✅ හරි! මේ පිටු වල ලස්සන මල් සහ පාට පාට මල් ගැන කියලා තිබෙනවා.",
  "qz003_que": "ලේන් අම්මා කඩලා දුන්නේ මොනවාද?",
  "qz003_o0": "එක, මලක්",
  "qz003_o0_exp": "❌ නැහැ. කතාවේ ලේන් අම්මා මලක් කඩලා දුන්නේ නැහැ.",
  "qz003_o1": "දෙක, ජම්බු ගෙඩියක්",
  "qz003_o1_exp": "✅ හරි! ලේන් අම්මා ජම්බු ගෙඩියක් කඩලා දුන්නා.",
  "qz003_o2": "තුන, කොළයක්",
  "qz003_o2_exp": "❌ නැහැ. ලේන් අම්මා කඩලා දුන්නේ කොළයක් නොවෙයි.",
  "qz004_que": "ළමයා උදෑසන දෙමාපියන්ට පා වැඳලා කොහෙද යන්නේ?",
  "qz004_o0": "එක, වෙළෙඳසැල",
  "qz004_o0_exp": "❌ නැහැ. මෙහි වෙළෙඳසැලට යන බව නොකියයි.",
  "qz004_o1": "දෙක, පාසල්",
  "qz004_o1_exp": "✅ හරි! කවියේ කියන්නේ දෙමාපියන්ට පා වැඳලා පාසල් යනවා කියලා.",
  "qz004_o2": "තුන, උයන",
  "qz004_o2_exp": "❌ වැරදියි. පාඩමේ කියන්නේ පාසල් යනවා කියලා.",
  "qz005_que": "ළමයින් එකවර සතුටින් ‘පනිමු’ කියා තෝරාගත්තේ මොන සෙල්ලමද?",
  "qz005_o0": "එක, එල්ලේ",
  "qz005_o0_exp": "❌ නැහැ. ‘එල්ලේ ගහමු ද’ කියා ඇහුවත්, ඔවුන් තෝරාගත්තේ මේ සෙල්ලම නොවේ.",
  "qz005_o1": "දෙක, ඔන්චිලි",
  "qz005_o1_exp": "❌ වැරදියි. ‘ඔන්චිලි පදිමු ද’ කියා සඳහන් වුණත්, හැමෝම එකඟ වූයේ බට්ටා සෙල්ලමටයි.",
  "qz005_o2": "තුන, බට්ටා",
  "qz005_o2_exp": "✅ හරි! ළමයින් ‘බට්ටා පනිමු’ කියා සතුටින් එකවර කිව්වා.",
  "qz006_que": "මේ පිටු වල වැඩිපුරම කියවෙන්නේ කුමන උත්සවය ගැනද?",
  "qz006_o0": "එක, නත්තල්",
  "qz006_o0_exp": "❌ නැහැ. නත්තල් ගැන සඳහන් නොවේ. කතාවේ තිබෙන්නේ අවුරුදු සමයේ කරන දේවල් ගැනයි.",
  "qz006_o1": "දෙක, අවුරුදු",
  "qz006_o1_exp": "✅ හරි! මේ පිටු වල අවුරුදු උත්සවය, කිරිබත්, කැවිලි සහ නෑදෑයන් එක්වීම ගැන කියයි.",
  "qz006_o2": "තුන, වෙසක්",
  "qz006_o2_exp": "❌ නැහැ. මේ පිටු වල වෙසක් ගැන නොව, අලුත් ඇඳුම්, කිරිබත්, කැවිලි සහ ආයුබෝවන් කියන අවුරුදු ගැන කියයි.",
  "qz007_que": "කිරි සුදු හාවා කෑවේ මොනවාද?",
  "qz007_o0": "එක, රත්තරං",
  "qz007_o0_exp": "❌ නැහැ. රත්තරං කියලා තිබෙන්නේ රබන් පදයේය, හාවා කෑ දෙයක් නොවේ.",
  "qz007_o1": "දෙක, දලු කොළ",
  "qz007_o1_exp": "❌ නැහැ. දලු කොළ ගැන කියන්නේ ගස්වල කොළ නැටුණු බවයි, හාවා කෑ දේ නොවේ.",
  "qz007_o2": "තුන, උඳුපියළිය කොළ",
  "qz007_o2_exp": "✅ හරි! කවියේ කිරි සුදු හාවා 'උඳුපියළිය කොළ කෑවා' කියලා ඇත.",
  "qz008_que": "මනුක ඇළේ දුටුවේ කාවද?",
  "qz008_o0": "එක, බළලෙක්",
  "qz008_o0_exp": "❌ නැහැ. මනුක ඇළේ බළලෙකු නොදුටුවා.",
  "qz008_o1": "දෙක, පුංචි මාළුවා",
  "qz008_o1_exp": "✅ හරි! මනුක ඇළේ පුංචි මාළුවෙකු දැක්කා.",
  "qz008_o2": "තුන, කුරුල්ලෙක්",
  "qz008_o2_exp": "❌ නැහැ. කතාවේ කුරුල්ලෙක් ගැන නොකියයි.",
  "qz009_que": "පොළේ පවනි විකුණුවේ මොනවාද?",
  "qz009_o0": "එක, මෑ කරල්",
  "qz009_o0_exp": "❌ මේක කසුන් විකුණුවේ. පවනි විකුණුවේ බණ්ඩක්කා.",
  "qz009_o1": "දෙක, බණ්ඩක්කා",
  "qz009_o1_exp": "✅ හරි! පාඨයේ පවනි බණ්ඩක්කා විකුණුවා කියලා තිබෙනවා.",
  "qz009_o2": "තුන, කැරට්",
  "qz009_o2_exp": "❌ කැරට් පොළේ තිබුණා, නමුත් පවනි විකුණුවේ ඒවා නොවේ.",
  "qz010_que": "පුතාලා ඊයේ කොහේ ද ගියේ?",
  "qz010_o0": "එක, වෙළඳපොළට",
  "qz010_o0_exp": "❌ නැහැ. වෙළඳපොළ ගැන මෙහි සඳහන් වෙන්නේ නැහැ.",
  "qz010_o1": "දෙක, පාසලට",
